DATABASE_URL="mysql://baton:baton@127.0.0.1:3307/baton"
SHADOW_DATABASE_URL="mysql://root:root@127.0.0.1:3307/baton_shadow"
# Outbox 보존 일수. 재생 창(24시간)보다 짧은 값은 서버 기동 시 거부한다.
BATON_OUTBOX_RETENTION_DAYS=30
PORT=3001
WEB_PORT=3000
# 서버 CORS 허용 origin (쉼표 구분)
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# 알림·이메일의 webUrl 을 만들 때 쓰는 웹 주소. **브라우저로 접속하는 origin 과 반드시 같아야 한다.**
# localhost 와 127.0.0.1 은 서로 다른 origin 이라 로그인 세션(localStorage)이 분리된다.
# 비워 두면 dev-up.sh 가 http://127.0.0.1:$WEB_PORT 로 채운다.
WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_MODE=real

# 인증 제공자. 등록되지 않은 제공자는 서버 기동 시 오류로 처리한다.
# local(기본) | accounts(사내 accounts) | oidc(표준 OIDC). 주지 않으면 지금처럼 local 이다.
AUTH_PROVIDER=local
# 처음 보는 외부 신원의 신규 User 생성은 명시적으로 켤 때만 허용한다.
AUTH_AUTO_PROVISION=false

# --- redirect 제공자 (AUTH_PROVIDER 가 local 이 아닐 때만 읽는다) ---
# 콜백은 웹이 아니라 **이 서버**가 받는다. client_secret 을 브라우저에 둘 수 없기 때문이다.
# REDIRECT_URI 는 제공자에 등록한 값과 글자까지 같아야 하고, 이 주소의 origin 이
# 웹 로그인 버튼이 향하는 /v1/auth/authorize 주소가 된다.
#
# 사내 accounts (표준 OIDC 가 아니다 — discovery·id_token·JWKS·PKCE 없음)
# ACCOUNTS_ISSUER=https://accounts.example.com
# ACCOUNTS_CLIENT_ID=
# ACCOUNTS_CLIENT_SECRET=
# ACCOUNTS_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/callback
# ACCOUNTS_SCOPE=openid profile email
#
# 표준 OIDC (discovery + JWKS + PKCE)
# OIDC_ISSUER=https://sso.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/callback
# OIDC_SCOPE=openid profile email
# AUTH_PROVIDER 값과 제공자 이름을 다르게 쓰고 싶을 때만 (예: AUTH_PROVIDER=company-sso)
# OIDC_PROVIDER_ID=oidc

# 파일 저장소. 기본은 로컬 디스크(STORAGE_DIR). s3 로 바꾸면 S3_BUCKET 이 필요하다.
# S3_ENDPOINT 를 주면 S3 호환 저장소(MinIO 등)를 path-style 로 쓴다. 비우면 AWS S3.
# STORAGE_DRIVER=s3
# S3_BUCKET=baton
# S3_ENDPOINT=https://s3.example.com
# AWS_REGION=<your-region>
